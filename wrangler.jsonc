{
  "name": "wardrobe-submission-example",
  "main": "worker-dist/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "WARDROBE_ORDINARY_MODE": "disabled",
    "APP_ORIGIN": "http://127.0.0.1:4173"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "META_TRIAL",
        "class_name": "MetaTrial"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-meta-trial",
      "new_sqlite_classes": [
        "MetaTrial"
      ]
    }
  ]
}
