# SERVER ONLY. Documentation placeholders, not credentials or live approval.
MODEL_API_KEY=
# Default launcher always sets disabled. Never enable without explicit photo/spend approval.
WARDROBE_LIVE_MODE=disabled
# Exact hashes of normalized PNGs shown locally in The Pile, comma-separated.
WARDROBE_APPROVED_IMAGE_SHA256=
# ISO 8601 UTC timestamp, future but at most one hour after server startup.
WARDROBE_APPROVAL_EXPIRES_AT=
# Whole server-process attempt cap 1..10; default 0 denies. Not a dollar billing cap.
WARDROBE_MAX_CALLS=0
# Additional explicit permission for metadata-only outfit reasoning.
WARDROBE_ALLOW_REASONING=disabled
